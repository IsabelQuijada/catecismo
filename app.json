{
  "expo": {
    "name": "Catequesis Cocula Jalisco",
    "slug": "catequesis-cocula-jalisco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/content/branding/logo-catequesis-cocula.png",
    "userInterfaceStyle": "light",
    "scheme": "catequesis-cocula",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/content/branding/favicon-catequesis-cocula-optimized.png",
      "name": "Catequesis Cocula",
      "shortName": "Catequesis",
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/catecismo"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
